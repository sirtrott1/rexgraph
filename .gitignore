# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.installed.cfg

# Compiled extensions and local native libraries
*.so
*.pyd
*.dylib

# Build / packaging artifacts
build/
/build
dist/
wheels/
*.whl
.mesonpy-*/
_skbuild/
# set aside build directories, such as one built with a mismatched toolchain
build*.bak/

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Distribution archives (source is checked in, not zips)
*.zip
*.tar.gz

# Local env / secrets / logs (never commit real config or credentials)
.env
.venv
*.log
certs/
*.pem

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local editor and coding tool state
.claude/
.codex/
.remember/
.superpowers/

# Generated stress/perf fixtures (not committed; regenerate as needed)
test_data/

# Agent's licensed UI runtime ships in source and wheel distributions.

# Local demos / scratch (not shipped)
playground/
agent/frontend/theme-ps2-preview.html

# Archived local working files are excluded from distributions.
docs/v1.0.4/

# The optional attention capture binary links to a local llama.cpp build.
agent/agent/native/rex_attn_capture

# Local maintenance records and repository instructions are not shipped.
CHANGELOG.md
AGENTS.md

# Local generated output
bio-demo-out/

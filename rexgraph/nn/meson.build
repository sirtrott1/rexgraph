# rexgraph.nn - pure-Python ML substrate (optimizers, propagators, attention, factory).
# torch is optional (guarded at use); these ship with the wheel as source.
py.install_sources(
    ['__init__.py', 'optim.py', '_experimental.py', 'factory.py', 'rcf_torch.py',
     'relational_attention.py', 'layers.py', 'tf_relational.py'],
    subdir: 'rexgraph/nn',
)
